@base = http://localhost:3000/api/v1
@token = {{login.response.body.$.token}}

### register a new patient
POST {{base}}/auth/register
Content-Type: application/json

{
    "firstName": "Test",
    "lastName": "User",
    "birthDate": "2000-01-01T00:00:00Z",
    "gender": "male",
    "email": "test.user@example.com",
    "password": "secret123"
}

### register with an email that's already taken — should be 409
POST {{base}}/auth/register
Content-Type: application/json

{
    "firstName": "Test",
    "lastName": "User",
    "birthDate": "2000-01-01T00:00:00Z",
    "gender": "male",
    "email": "Neer.doctor@example.com",
    "password": "secret123"
}

### login as the seeded doctor
# @name login
POST {{base}}/auth/login
Content-Type: application/json

{
    "email": "Neer.doctor@example.com",
    "password": "123456"
}

### login with wrong password — should be 401
POST {{base}}/auth/login
Content-Type: application/json

{
    "email": "Neer.doctor@example.com",
    "password": "wrong-password"
}


#
#APPOINTMENT
#
### get all your current appointment
GET {{base}}/appointments
Authorization: Bearer {{token}}

### get one appointment
# GET {{base}}/appointments/f7641ba0-eba2-4b1c-beb7-3cee4fd7bd29
GET {{base}}/appointments/11111111-1111-1111-1111-111111111111
Authorization: Bearer {{token}}

### create an appointment
POST {{base}}/appointments
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "patientId": "22222222-2222-2222-2222-222222222222",
    "doctorId": "33333333-3333-3333-3333-333333333333",
    "startTime": "2026-09-04T09:00:00Z",
    "description": "checkup"
}

### bad body — should be 422
POST {{base}}/appointments
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "doctorId": ""
}

### cancel an appointment (owned by the mock patient — should succeed)
# PATCH {{base}}/appointments/11111111-1111-1111-1111-111111111111
PATCH {{base}}/appointments/02afec80-f9f5-496d-9e90-1ba177e1ac4c
Authorization: Bearer {{token}}

### cancel someone else's appointment — should be 403
PATCH {{base}}/appointments/66666666-6666-6666-6666-666666666666
Authorization: Bearer {{token}}

### cancel a nonexistent appointment — should be 404
PATCH {{base}}/appointments/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{token}}

### get doctor info
GET {{base}}/doctor/33333333-3333-3333-3333-333333333333
Authorization: Bearer {{token}}

### get nonexistent doctor — should be 404
GET {{base}}/doctor/99999999-9999-9999-9999-999999999999
Authorization: Bearer {{token}}

### doctor slots
GET {{base}}/doctor/33333333-3333-3333-3333-333333333333/slots?date=2026-09-01